# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./kai.db

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# E-commerce API Keys (Mock for development)
AMAZON_API_KEY=mock_amazon_key
FLIPKART_API_KEY=mock_flipkart_key
MEESHO_API_KEY=mock_meesho_key
MYNTRA_API_KEY=mock_myntra_key
AJIO_API_KEY=mock_ajio_key

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
